<Application x:Class="Squish.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Squish"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Swapped for Dark.xaml by ThemeManager. -->
                <ResourceDictionary Source="Themes/Light.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <FontFamily x:Key="Ui">Segoe UI Variable Text, Segoe UI</FontFamily>
            <FontFamily x:Key="Display">Segoe UI Variable Display, Segoe UI</FontFamily>

            <local:VisibleWhen x:Key="VisibleWhen" />
            <local:Fraction x:Key="Fraction" />

            <!-- Thin-stroke icons, drawn rather than taken from an icon font. -->
            <Geometry x:Key="IconArrowDown">M 13,0 L 13,26 M 4,17 L 13,26 L 22,17</Geometry>
            <Geometry x:Key="IconPlus">M 5,0 L 5,10 M 0,5 L 10,5</Geometry>
            <Geometry x:Key="IconCross">M 0,0 L 9,9 M 9,0 L 0,9</Geometry>
            <Geometry x:Key="IconReveal">M 1,9 L 9,1 M 3,1 L 9,1 L 9,7</Geometry>
            <Geometry x:Key="IconMinimize">M 0,0.5 L 10,0.5</Geometry>
            <Geometry x:Key="IconMaximize">M 0.5,0.5 L 9.5,0.5 L 9.5,9.5 L 0.5,9.5 Z</Geometry>
            <Geometry x:Key="IconClose">M 0,0 L 10,10 M 10,0 L 0,10</Geometry>
            <Geometry x:Key="GlyphImage">M 0.5,1.5 L 13.5,1.5 L 13.5,12.5 L 0.5,12.5 Z M 2,11 L 5.5,7 L 8,9.5 L 10,7.5 L 12,11</Geometry>
            <Geometry x:Key="GlyphPdf">M 1.5,0.5 L 8,0.5 L 11.5,4 L 11.5,13.5 L 1.5,13.5 Z M 8,0.5 L 8,4 L 11.5,4 M 4,7.5 L 9,7.5 M 4,10 L 9,10</Geometry>
            <Geometry x:Key="GlyphVideo">M 0.5,2.5 L 13.5,2.5 L 13.5,11.5 L 0.5,11.5 Z M 5.5,5 L 9.5,7 L 5.5,9 Z</Geometry>
            <Geometry x:Key="GlyphAudio">M 1,6 L 1,8 M 3.5,4 L 3.5,10 M 6,1.5 L 6,12.5 M 8.5,4.5 L 8.5,9.5 M 11,3 L 11,11 M 13.5,6 L 13.5,8</Geometry>

            <Style x:Key="Body" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource Ui}" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            </Style>

            <!-- Tabular figures so sizes and percentages line up. -->
            <Style x:Key="Figures" TargetType="TextBlock" BasedOn="{StaticResource Body}">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            </Style>

            <Style x:Key="FocusRing">
                <Setter Property="Control.Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <Rectangle Margin="-3" StrokeThickness="1" Stroke="{DynamicResource Accent}" StrokeDashArray="2 2" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- No chrome at all: just the content, clickable. -->
            <Style x:Key="Bare" TargetType="Button">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent">
                                <ContentPresenter />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Plain text that darkens on hover. Colours go on the Button's own
                 Foreground: element content inherits from the Button (its logical
                 parent), not from the template. -->
            <Style x:Key="Quiet" TargetType="Button" BasedOn="{StaticResource Bare}">
                <Setter Property="Foreground" Value="{DynamicResource Muted}" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                <ContentPresenter x:Name="Content" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Content" Property="Opacity" Value="0.6" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Bare}">
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource Background}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Box" Background="{DynamicResource Ink}" BorderBrush="Transparent" BorderThickness="1"
                                    Height="32" Padding="18,0">
                                <ContentPresenter x:Name="Content" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Box" Property="Opacity" Value="0.78" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Box" Property="Background" Value="{DynamicResource Wash}" />
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Line}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="{DynamicResource Faint}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Minimise / maximise / close, drawn to match. -->
            <Style x:Key="Caption" TargetType="Button" BasedOn="{StaticResource Bare}">
                <Setter Property="Width" Value="46" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Cursor" Value="Arrow" />
                <Setter Property="Foreground" Value="{DynamicResource Muted}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Box" Background="Transparent">
                                <Path x:Name="Glyph" Data="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Stroke="{TemplateBinding Foreground}" StrokeThickness="1"
                                      Width="10" Height="10" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      SnapsToDevicePixels="True" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Box" Property="Background" Value="{DynamicResource Wash}" />
                                    <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource Ink}" />
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True" />
                                        <Condition Property="Tag" Value="close" />
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Box" Property="Background" Value="{DynamicResource CloseHover}" />
                                    <Setter TargetName="Glyph" Property="Stroke" Value="White" />
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- A 1.5 px accent line; an accent segment sweeps when indeterminate. -->
            <Style x:Key="Hairline" TargetType="ProgressBar">
                <Setter Property="Height" Value="1.5" />
                <Setter Property="Minimum" Value="0" />
                <Setter Property="Maximum" Value="1" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid ClipToBounds="True">
                                <Border x:Name="PART_Track" />
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{DynamicResource Accent}" />
                                <Border x:Name="Sweep" Width="140" HorizontalAlignment="Left" Background="{DynamicResource Accent}" Visibility="Collapsed">
                                    <Border.RenderTransform>
                                        <TranslateTransform X="-140" />
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsIndeterminate" Value="True">
                                    <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="Sweep" Property="Visibility" Value="Visible" />
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetName="Sweep"
                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                 From="-140" To="720" Duration="0:0:1.1">
                                                    <DoubleAnimation.EasingFunction>
                                                        <SineEase EasingMode="EaseInOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Slim scrollbar: just a thumb that appears on hover. -->
            <Style TargetType="ScrollBar">
                <Setter Property="Width" Value="8" />
                <Setter Property="MinWidth" Value="8" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="Bar" Background="{DynamicResource Line}" Width="4" CornerRadius="2" Margin="0,2" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Faint}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ToolTip">
                <Setter Property="FontFamily" Value="{StaticResource Ui}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{DynamicResource Ink}" />
                <Setter Property="Background" Value="{DynamicResource Background}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
                <Setter Property="Padding" Value="8,4" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
